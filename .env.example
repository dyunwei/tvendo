# Published image tag. Pin a release such as 0.1.0 for production.
TVENDO_VERSION=latest
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator
# Generate using: openssl rand -hex 32. Keep stable: used to encrypt upstream keys.
ENCRYPTION_KEY=replace-with-64-hex-characters
# Production behind HTTPS: true. Local HTTP development: false.
COOKIE_SECURE=false
# Actual trusted reverse proxy peer addresses only (comma separated CIDRs).
TRUSTED_PROXY_CIDRS=
PUBLIC_URL=http://localhost:8080
PORT=8080
# Local development with `make deps-up` (isolated ports):
DATABASE_URL=postgres://tvendo:replace-with-a-long-random-password@127.0.0.1:15432/tvendo?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0

# Optional catalog search via Alibaba Cloud Bailian. Copy full endpoints from
# your workspace/region; embedding and rerank use separate endpoints.
# Example embedding: https://<workspace>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
SEARCH_EMBEDDING_URL=
SEARCH_EMBEDDING_MODEL=qwen3.7-text-embedding
# auto: E5 models get query:/passage: prefixes, other models get raw text.
SEARCH_EMBEDDING_FORMAT=auto
SEARCH_EMBEDDING_DIMENSIONS=1024
# Increment after changing model weights, pooling, truncation or preprocessing.
SEARCH_EMBEDDING_REVISION=1
SEARCH_EMBEDDING_API_KEY=
# Used only without rerank. With rerank, vector recall uses top candidates.
SEARCH_MIN_SCORE=0.75
# Example DashScope: https://<workspace>.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
SEARCH_RERANK_URL=
SEARCH_RERANK_MODEL=qwen3-rerank
# dashscope (nested payload) or openai (flat /compatible-api/v1/reranks).
SEARCH_RERANK_FORMAT=dashscope
SEARCH_RERANK_API_KEY=
SEARCH_RERANK_CANDIDATES=30
# Provisional starting cutoff, NOT probability; calibrate on real queries.
SEARCH_RERANK_MIN_SCORE=0.55
# Optional, explicit web-search fallback tool_ref from this deployment.
# Suggested separately only for non-degraded searches with no matching tools.
SEARCH_FALLBACK_TOOL_REF=

# Optional WeChat Pay Native (APIv3).
# Fill common fields and the selected verification mode.
WECHAT_PAY_ENABLED=false
# Required when enabled: full public HTTPS callback URL; independent of PUBLIC_URL.
# Example: https://payments.example.com/api/payments/wechat/notify
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
# Merchant API certificate serial number (not the WeChat Pay public-key ID).
WECHAT_PAY_SERIAL_NO=
# Local development: absolute paths. Compose: paths inside the container below.
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay/apiclient_key.pem
# public_key (default, compatible with existing deployments) or certificate.
WECHAT_PAY_VERIFY_MODE=public_key
# CertificateDownloader output: set mode=certificate, fill this path; public-key fields may stay empty.
# Use the downloaded WeChat Pay PLATFORM certificate, never the merchant apiclient_cert.pem.
WECHAT_PAY_PLATFORM_CERT_PATH=
# Only required in public_key mode.
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechat-pay/wechatpay_public_key.pem
# Host directory mounted by compose.wechat.yaml; keep key files outside Git.
WECHAT_PAY_KEYS_DIR=./secrets/wechat-pay

# Optional email verification and password reset (TLS SMTP).
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional token for Prometheus scraping. Generate with openssl rand -hex 32.
METRICS_TOKEN=
