# Published image tag. Pin a release such as 0.1.0 for production.
TVENDO_VERSION=latest
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Administrator
# Generate using: openssl rand -hex 32. Keep stable: used to encrypt upstream keys.
ENCRYPTION_KEY=replace-with-64-hex-characters
# Production behind HTTPS: true. Local HTTP development: false.
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:8080
PORT=8080
# Local development with `make deps-up` (isolated ports):
DATABASE_URL=postgres://tvendo:replace-with-a-long-random-password@127.0.0.1:15432/tvendo?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0
